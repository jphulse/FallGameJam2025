# Visual Studio 2015 user specific files
TeamCube/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
TeamCube/*.xcodeproj
TeamCube/*.xcworkspace
TeamCube/*.sln
TeamCube/*.suo
TeamCube/*.opensdf
TeamCube/*.sdf
TeamCube/*.VC.db
TeamCube/*.VC.opendb
TeamCube/.vsconfig

# Precompiled Assets
TeamCube/SourceArt/**/*.png
TeamCube/SourceArt/**/*.tga

# Binary Files
TeamCube/Binaries/*
TeamCube/Plugins/**/Binaries/*

# Builds
TeamCube/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!TeamCube/Build/*/
TeamCube/Build/**/*
!TeamCube/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!TeamCube/Build/**/*.ico

# Built data for maps
TeamCube/*_BuiltData.uasset

# Configuration files generated by the Editor
TeamCube/Saved/*

# Compiled source files for the engine to use
TeamCube/Intermediate/*
TeamCube/Plugins/**/Intermediate/*

# Cache files for the editor to use
TeamCube/DerivedDataCache/*

# Godot metadata and import folders in all subprojects
*/.godot/
*/.import/

# Godot-generated files
*/*.import
*/export.cfg
*/export_presets.cfg

# Local editor and layout configs
*/editor_layout.cfg
*/editor_settings-*.cfg

# Mono / C# specific cache and build folders
*/.mono/
*/.vs/
*/bin/
*/obj/
*/Properties/

# Temporary and cache folders
*/.godot/mono/temp/
*/.godot/editor_settings/
*/.godot/tmp_*/
*/.godot/asset_cache/

# Platform-specific export and build caches
*/android/
*/ios/
*/.gradle/
*/build/

# ------------------------------------------------------------
# OS / IDE / tooling junk
# ------------------------------------------------------------
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*.swo

# Build outputs
build/
bin/
dist/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.zip
*.tar.gz

# Editor / Environment
.vscode/
.idea/
.env
.env.local
*.code-workspace

# ------------------------------------------------------------
# Notes
# ------------------------------------------------------------
# Keep these under version control:
#   */project.godot
#   */icon.png or icon.svg
#   Your scenes, scripts, and assets.
#
# This setup allows multiple Godot subprojects to coexist
# under one repository root cleanly. Gitignore modified by chatGPT
